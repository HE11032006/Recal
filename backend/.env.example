# Runtime
APP_ENV=development
APP_NAME=recal-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Observability — Sentry DSN à fournir uniquement dans l’environnement de déploiement
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default
# Credentials recommandées : profil AWS CLI/SSO ou rôle IAM. Ne pas mettre de clé secrète ici.
# Inference Profile US requis pour l’invocation on-demand en us-east-1.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
DYNAMODB_TABLE_OPPORTUNITIES=recal-opportunities-dev
DYNAMODB_TABLE_PROFILES=recal-profiles-dev
DYNAMODB_TABLE_RUNS=recal-runs-dev

# Search provider : parallel (gratuit, sans clé) | tavily (clé requise) | none
SEARCH_PROVIDER=parallel
PARALLEL_SEARCH_ENDPOINT=https://search.parallel.ai/mcp

# Tavily — ne jamais committer la vraie valeur (fallback optionnel)
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# Analyzer provider : fake (heuristique locale) | strands (Claude via Bedrock)
ANALYZER_PROVIDER=fake

# Agent limits
AGENT_MAX_TOOL_CALLS=3
AGENT_TIMEOUT_SECONDS=60
RELEVANCE_THRESHOLD_DEFAULT=70
