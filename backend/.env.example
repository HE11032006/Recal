# Runtime
APP_ENV=development
APP_NAME=recal-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Observability — Sentry DSN à fournir uniquement dans l’environnement de déploiement
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default
# Credentials recommandées : profil AWS CLI/SSO ou rôle IAM. Ne pas mettre de clé secrète ici.
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
DYNAMODB_TABLE_OPPORTUNITIES=recal-opportunities-dev
DYNAMODB_TABLE_PROFILES=recal-profiles-dev
DYNAMODB_TABLE_RUNS=recal-runs-dev

# Tavily — ne jamais committer la vraie valeur
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# Agent limits
AGENT_MAX_TOOL_CALLS=3
AGENT_TIMEOUT_SECONDS=60
RELEVANCE_THRESHOLD_DEFAULT=70
